{
  "outputDirectory": "public",
  "functions": { "api/**/*.js": { "includeFiles": "data/**", "maxDuration": 30 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?p=:path*" },
    { "source": "/((?!api/|css/|js/).*)", "destination": "/index.html" }
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ]
  }]
}
